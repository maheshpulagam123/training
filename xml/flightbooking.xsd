<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://sidgs/flightbookings">
    <xs:element name="flightbokkings">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="flightbooking" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="bookingid" type="xs:positiveInteger"/>
                            <xs:element name="bookingstatus" type="xs:string" />
                            <xs:element name="bookingdate" type="xs:date" />
                            <xs:element name="passenger">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="passengerid" type="xs:positiveInteger"/>
                                        <xs:element name="email" type="xs:string" />
                                        <xs:element name="name" type="xs:string" />
                                        <xs:element name="contactnumbers">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="contactnumber" type="xs:positiveInteger" />
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="flight">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="flightnumber" type="xs:string" />
                                        <xs:element name="airline" type="xs:string" />
                                        <xs:element name="origination" type="xs:string" />
                                        <xs:element name="destination" type="xs:string" />
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                       
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="totalbookings" type="xs:positiveInteger" />
        </xs:complexType>
    </xs:element>
</xs:schema>